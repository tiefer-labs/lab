# Copy to .env (gitignored) only if your tooling reads it; the code reads
# these variables from the environment. No secrets belong here.

# Where the data cache is written and read. Default: ./data
TIEFER_DATA_DIR=./data

# Where training runs (checkpoints, metadata, metrics) are written. Default: ./runs
TIEFER_RUNS_DIR=./runs

# Where evaluation, export and benchmark reports are written. Default: ./reports
TIEFER_REPORTS_DIR=./reports

# CSC Roihu only: the CSC project name used for --account and for the
# /projappl and /scratch paths. Set it in ~/.bashrc on Roihu, never commit it.
# TIEFER_CSC_PROJECT=<project>
